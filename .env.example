# 环境变量配置示例
# 复制为 .env 后按需填写。.env 已在 .gitignore 中，不会被提交。

# ============================================
# 内容仓库配置（代码与内容分离，可选功能）
# ============================================
# 默认关闭。开启后会在 pnpm dev / build 前从独立仓库同步内容到 content/ 目录。
# 注意：开启后 sync-content 脚本会在本仓库执行 git 操作（stash / commit），
# 如果你的内容就在本仓库里，保持 false 即可。
ENABLE_CONTENT_SYNC=false

# 内容仓库的 Git URL（仅在 ENABLE_CONTENT_SYNC=true 时需要）
# 支持 HTTPS 和 SSH：
#   HTTPS: https://github.com/your-username/your-content-repo.git
#   SSH:   git@github.com:your-username/your-content-repo.git
CONTENT_REPO_URL=

# 内容目录路径（相对项目根目录），一般无需改动
CONTENT_DIR=./content

# ============================================
# 日记页 Memos（可选）
# ============================================
# 留空则日记页使用 src/data/diary.ts 的静态数据。
#
# ⚠️ 不要把 Memos 令牌写进 src/config/siteConfig.ts 的 diaryApiUrl：
#    那个值会被原样输出到页面 HTML，任何访客都能看到。
#    如需接入 Memos，请在这里配置，并改用环境变量读取。
# MEMOS_API_URL=
# MEMOS_TOKEN=

# ============================================
# Supabase 配置（留言板 + 日记共用，可选功能）
# ============================================
# 留言和日记都存在 Supabase（数据库 + 图片存储），本站保持纯静态。
#   - 留言板：匿名可读可写        → 步骤见 docs/GUESTBOOK.md
#   - 日记：  匿名只读，登录才可写 → 步骤见 docs/DIARY.md
# 两者可以共用一个 Supabase 项目，所以只需要下面这两个值。
#
# 这两个值都会被编进前端产物，这是 Supabase 的设计：
# 安全性靠数据库的行级安全策略（RLS）保证，不靠隐藏这个 key。
#
# ⚠️ 绝对不要把 service_role key 写在这里或任何前端代码里。
#    它绕过所有权限策略，泄露等于把整个数据库交出去。
#
# ⚠️ 部署到线上时，记得在托管平台（如 EdgeOne）的环境变量里也加上这两个值，
#    否则线上构建出的页面连不上 Supabase。
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# Cloudflare Turnstile 验证码（日记管理页登录用）
# ============================================
# 如果你在 Supabase 的 Authentication → Attack Protection 里开启了
# 验证码保护，Supabase 会要求登录请求带上验证码 token。
#
# 这里是 Turnstile 的 Site Key（公开值，可以写进前端）。
# 注意 Secret Key 不填在这里 —— 它要填到 Supabase 后台，
# 因为校验是 Supabase 服务端做的。
#
# ❗ 不填这个值，日记管理页将无法登录（会一直报「登录失败」）。
#
# 获取步骤：
#   1. 打开 https://dash.cloudflare.com → Turnstile → Add widget
#   2. 添加你的域名（本地调试再加 localhost）
#   3. 把 Site Key 填到这里，Secret Key 填进 Supabase 后台
PUBLIC_TURNSTILE_SITE_KEY=
