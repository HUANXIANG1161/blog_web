---
/**
 * HeadTags.astro
 * Head 标签组件 - 包含 SEO meta 标签、主题初始化脚本、CSS 变量等
 *
 * 提取自 Layout.astro 以实现更好的代码组织
 */

import { profileConfig, siteConfig } from "@/config";

import {
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
} from "../../constants/constants";
import { defaultFavicons } from "../../constants/icon";
import type { Favicon } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	// SEO
	title: string;
	description?: string;

	// Open Graph
	ogImageUrl?: string;
	setOGTypeArticle?: boolean;

	// 配置
	configHue: number;
}

const {
	title,
	description,
	ogImageUrl,
	setOGTypeArticle = false,
	configHue,
} = Astro.props;

// 关键词
const keywords = siteConfig.keywords;

// Favicons
const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
---

<!-- SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description || title} />
{
	keywords && keywords.length > 0 && (
		<meta name="keywords" content={keywords.join(", ")} />
	)
}
<meta name="author" content={profileConfig.name} />

<!--
	canonical：告诉搜索引擎哪个是这一页的正式地址。
	这个主题原本只输出 og:url，没有 canonical；站点有了正式域名后补上，
	避免带查询参数或大小写不同的地址被当成多个页面重复收录。
	Astro.url 已是绝对地址，且与 trailingSlash: "always" 的产物一致。
-->
<link rel="canonical" href={Astro.url} />

<!-- Open Graph Tags -->
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || title} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && <meta property="og:image:width" content="1200" />}
{ogImageUrl && <meta property="og:image:height" content="630" />}
{
	setOGTypeArticle ? (
		<meta property="og:type" content="article" />
	) : (
		<meta property="og:type" content="website" />
	)
}

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || title} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
<!-- Viewport and Generator -->
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

<!-- Favicons -->
{
	favicons.map((favicon) => (
		<link
			rel="icon"
			href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
			sizes={favicon.sizes}
			media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
		/>
	))
}

<!-- 字体通过构建脚本压缩到 /assets/font/ 目录，此处不再预加载以避免 404 -->
<!-- 相关脚本：scripts/compress-fonts/index.js（需手动运行，未接入 build） -->

<!-- 预连接 Iconify API 以减少图标加载延迟 -->
<link rel="preconnect" href="https://api.iconify.design" crossorigin />

<!-- Set the theme before the page is rendered to avoid a flash -->
<script
	is:inline
	define:vars={{
		DEFAULT_THEME,
		LIGHT_MODE,
		DARK_MODE,
		BANNER_HEIGHT_EXTEND: 30,
		configHue,
		themeColorFixed: siteConfig.themeColor.fixed ?? false,
		pageScaling: siteConfig.pageScaling,
		ultrawidePostLayout: {
			enable: siteConfig.ultrawidePostLayout?.enable ?? false,
			allowSwitch: siteConfig.ultrawidePostLayout?.allowSwitch ?? true,
		},
	}}
>
	// Load the theme from local storage
	const theme = localStorage.getItem("theme") || DEFAULT_THEME;
	let isDark = false;
	switch (theme) {
		case LIGHT_MODE:
			document.documentElement.classList.remove("dark");
			isDark = false;
			break;
		case DARK_MODE:
			document.documentElement.classList.add("dark");
			isDark = true;
			break;
	}

	// Set the theme for Expressive Code based on current mode
	const expressiveTheme = isDark ? "github-dark" : "github-light";
	const currentTheme = document.documentElement.getAttribute("data-theme");
	// 只在主题不同时才更新，避免触发不必要的重绘
	if (currentTheme !== expressiveTheme) {
		document.documentElement.setAttribute("data-theme", expressiveTheme);
	}

	// Load the hue from local storage
	const hue = themeColorFixed ? configHue : (localStorage.getItem("hue") || configHue);
	document.documentElement.style.setProperty("--hue", hue);

	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - (offset % 4);
	document.documentElement.style.setProperty(
		"--banner-height-extend",
		`${offset}px`,
	);

	// 超宽屏文章布局。在首帧前落到 <html> 上，避免布局闪烁。
	(function () {
		const stored = ultrawidePostLayout.allowSwitch
			? localStorage.getItem("ultrawidePostLayout")
			: null;
		document.documentElement.dataset.ultrawidePost = String(
			stored !== null ? stored === "true" : ultrawidePostLayout.enable,
		);
	})();

	// 兼容旧配置的可选页面缩放。默认布局不再依赖根字号缩放。
	(function () {
		const root = document.documentElement;
		if (!pageScaling || !pageScaling.enable) {
			root.style.removeProperty("font-size");
			return;
		}

		function adjustPageScale() {
			const isTouch =
				(window.matchMedia &&
					(window.matchMedia("(pointer:coarse)").matches ||
						window.matchMedia("(hover: none)").matches)) ||
				"ontouchstart" in window;
			const isPortrait =
				window.matchMedia &&
				window.matchMedia("(orientation: portrait)").matches;
			if (isTouch || isPortrait) {
				root.style.removeProperty("font-size");
				return;
			}

			const targetWidth = pageScaling.targetWidth || 2000;
			const currentWidth = root.clientWidth;
			const scale = Math.min(
				1,
				Math.max(0.85, currentWidth / targetWidth),
			);
			root.style.fontSize = `${scale * 100}%`;
		}

		adjustPageScale();
		window.addEventListener("resize", adjustPageScale);
		document.addEventListener("swup:page:view", adjustPageScale);
		window.addEventListener("orientationchange", adjustPageScale);
	})();
</script>

<!-- Dev mode script - avoid swup replacing head styles -->
<script is:inline define:vars={{ IS_DEV: import.meta.env.DEV }}>
	// Dev 模式下，避免 swup 在页面切换时反复替换 head 中的样式标签，导致偶发样式丢失
	if (IS_DEV) {
		document.addEventListener("swup:enable", () => {
			if (window?.swup?.options) {
				window.swup.options.updateHead = false;
			}
		});
		if (window?.swup?.options) {
			window.swup.options.updateHead = false;
		}
	}
</script>

<script is:inline>
	/**
	 * 让「内容靠客户端拉取」的页面整个绕过 Swup，走普通整页跳转。
	 *
	 * 原因：这些页面的正文是客户端请求 Supabase 后渲染的，而 Swup 做无刷新
	 * 跳转时不会重新执行页面脚本（浏览器也不会重新执行 URL 相同的 ES 模块）。
	 * 表现出来就是「从别的板块点进来一直加载中，手动刷新才正常」。
	 *
	 * 为什么不逐个链接加 data-no-swup：那只是打补丁，顶部导航、侧边栏、正文
	 * 里的链接都得各加一次，漏一个就复现（相册当初就是这么反复出问题的）。
	 * 这里按路径统一拦截，任何入口进来都走整页加载，稳定可靠。
	 *
	 * 整页跳转的代价可以接受：这些页面本来就要等一次网络请求，
	 * 换来的是「任何入口都正确」这个确定性。
	 *
	 * ⚠️ 以后新增「客户端渲染」的页面，记得把路径加进下面的列表 ——
	 * 否则从其它板块跳进去就会卡在加载态。
	 */
	(function () {
		// 需要绕过 Swup 的路径前缀
		var BYPASS_PREFIXES = ["/albums", "/guestbook", "/diary"];

		function shouldIgnoreVisit(url) {
			try {
				var path = new URL(url, window.location.origin).pathname;
				return BYPASS_PREFIXES.some(function (prefix) {
					return path === prefix || path.indexOf(prefix + "/") === 0;
				});
			} catch {
				return false;
			}
		}

		function patch() {
			var swup = window.swup;
			if (!swup || !swup.options) return;
			// 保留原本的忽略规则（data-no-swup 等），只额外忽略上面的路径
			var original = swup.options.ignoreVisit;
			swup.options.ignoreVisit = function (url, opts) {
				if (shouldIgnoreVisit(url)) return true;
				return typeof original === "function" ? original(url, opts) : false;
			};
		}

		// swup 就绪后打补丁；已经就绪时直接打
		document.addEventListener("swup:enable", patch);
		patch();
	})();
</script>
