---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { MomentCard } from "@components/features/diary";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig, diarySupabaseConfig } from "../config";
import { getAllTags, getDiaryList } from "../data/diary";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.diary) {
	return Astro.redirect("/404/");
}

const moments = getDiaryList();
const allTags = getAllTags();

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: moments.length,
	},
	...allTags.map((tag) => ({
		value: tag,
		label: tag,
		count: moments.filter((m) => m.tags?.includes(tag)).length,
	})),
];

const minutesAgo = i18n(I18nKey.diaryMinutesAgo);
const hoursAgo = i18n(I18nKey.diaryHoursAgo);
const daysAgo = i18n(I18nKey.diaryDaysAgo);

const diaryApiUrl = siteConfig.diaryApiUrl || "";

const title = i18n(I18nKey.diary);
const subtitle = i18n(I18nKey.diarySubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 relative w-full overflow-hidden">
			<!-- Gradient Banner -->
			<div class="px-6 sm:px-9 py-6">
				<div
					class="rounded-xl bg-linear-to-r from-(--primary) to-(--primary-dark,var(--primary)) p-5 sm:p-6"
				>
					<div class="flex items-center justify-between gap-4">
						<div class="min-w-0">
							<h1
								class="text-2xl sm:text-3xl font-bold text-white mb-1 drop-shadow-sm truncate"
							>
								{title}
							</h1>
							<p
								class="text-sm sm:text-base text-white/80 truncate"
							>
								{subtitle}
							</p>
						</div>
						<div class="shrink-0 text-center">
							<span
								class="block text-2xl sm:text-3xl font-bold text-white drop-shadow-sm"
							>
								{moments.length}
							</span>
							<span
								class="block text-xs sm:text-sm text-white/70"
							>
								{i18n(I18nKey.diaryCount)}
							</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Content -->
			<div class="px-6 sm:px-9 pt-2 pb-6">
				{
					moments.length > 0 && allTags.length > 0 && (
						<div class="mb-8">
							<FilterTabs tabs={filterTabs} dataAttr="tags" />
						</div>
					)
				}

				<div id="diary-list" class="space-y-4" data-memos-api={diaryApiUrl || ""} data-minutes-ago={minutesAgo} data-hours-ago={hoursAgo} data-days-ago={daysAgo}
					data-supabase-enabled={diarySupabaseConfig.enable ? "true" : "false"}
					data-page-size={String(diarySupabaseConfig.pageSize)}
				>
					{
						moments.map((moment, index) => (
							<MomentCard
								moment={moment}
								index={index}
								minutesAgo={minutesAgo}
								hoursAgo={hoursAgo}
								daysAgo={daysAgo}
							/>
						))
					}
				</div>

				<div id="no-results" class="hidden text-center py-16">
					<Icon
						name="material-symbols:edit-note"
						class="text-6xl text-black/15 dark:text-white/15 mb-4"
					/>
					<p class="text-black/40 dark:text-white/40 text-lg">
						{i18n(I18nKey.diaryNoResults)}
					</p>
				</div>

				{
					moments.length === 0 && (
						<div class="text-center py-16">
							<Icon
								name="material-symbols:edit-note"
								class="text-6xl text-black/15 dark:text-white/15 mb-4"
							/>
							<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2">
								{i18n(I18nKey.diaryNoResults)}
							</h3>
						</div>
					)
				}

				<div
					class="text-center mt-8 text-black/50 dark:text-white/50 text-sm italic"
				>
					{i18n(I18nKey.diaryTips)}
				</div>
			</div>
		</div>
	</div>

	{
		diaryApiUrl && (
			<script>
				import { renderDiaryList } from "@components/features/diary/render";
				import type { DiaryItem } from "../data/diary";

				(function () {
					const container = document.getElementById("diary-list");
					if (!container) {return;}
					const apiUrl = container.dataset.memosApi;
					if (!apiUrl) {return;}
					const labels = {
						minutesAgo: container.dataset.minutesAgo || "minutes ago",
						hoursAgo: container.dataset.hoursAgo || "hours ago",
						daysAgo: container.dataset.daysAgo || "days ago",
					};

					// Derive base URL for file attachments (strip /api/...)
					const baseUrl = apiUrl.replace(/\/api\/.*$/, "");

					// Memos API 返回的数据结构（只声明用到的字段）
					interface MemosAttachment {
						type: string;
						name: string;
						filename: string;
					}
					interface MemosItem {
						visibility: string;
						state: string;
						content: string;
						createTime: string;
						tags?: string[];
						attachments?: MemosAttachment[];
						location?: { placeholder?: string };
						pinned?: boolean;
					}
					/** 映射后的中间结构，含排序用的 pinned */
					type MemosMoment = DiaryItem & { pinned?: boolean };

					function transformMemosToDiary(memos: MemosItem[]): MemosMoment[] {
						return memos
							.filter(function (m) {
								return (
									m.visibility === "PUBLIC" && m.state === "NORMAL"
								);
							})
							.map(function (m, i) {
								const images =
									m.attachments && m.attachments.length > 0
										? m.attachments
												.filter(function (a) {
													return a.type.indexOf("image/") === 0;
												})
												.map(function (a) {
													return (
														baseUrl + "/file/" + a.name + "/" + a.filename
													);
												})
										: [];
								return {
									id: i,
									content: m.content,
									date: m.createTime,
									tags: m.tags || [],
									images: images.length > 0 ? images : undefined,
									location: m.location ? m.location.placeholder : undefined,
									pinned: m.pinned,
								};
							})
							.sort(function (a, b) {
								if (a.pinned && !b.pinned) {return -1;}
								if (!a.pinned && b.pinned) {return 1;}
								return new Date(b.date).getTime() - new Date(a.date).getTime();
							});
					}

					function fetchAndRender() {
						if (!apiUrl) {return;}

						fetch(apiUrl)
							.then(function (res) {
								if (!res.ok) {throw new Error("HTTP " + res.status);}
								return res.json();
							})
							.then(function (data) {
								const memos = data.memos || [];
								if (memos.length === 0) {return;}

								// 走共享渲染器，与 Supabase 数据源输出保持完全一致
								renderDiaryList(transformMemosToDiary(memos), labels);
							})
							.catch(function () {
								// Silent fallback — static data already rendered
							});
					}

					// IIFE: run immediately (handles Swup pre-render case)
					fetchAndRender();

					// DOMContentLoaded
					if (document.readyState === "loading") {
						document.addEventListener("DOMContentLoaded", fetchAndRender);
					}

					// Swup page transitions
					document.addEventListener("swup:contentReplaced", fetchAndRender);
				})();
			</script>
		)
	}

	<!--
		Supabase 数据源。
		数据在客户端拉取后替换列表 —— 这样写完日记刷新页面就能看到，
		不需要等站点重新构建。构建时的静态数据先渲染出来做兜底，
		取数失败时页面仍然有内容可看。
	-->
	{
		diarySupabaseConfig.enable && (
			<script>
				import {
					fetchDiaryEntries,
					isDiarySupabaseConfigured,
				} from "@components/features/diary-supabase/client";
				import { renderDiaryList } from "@components/features/diary/render";
				import type { DiaryItem } from "../data/diary";

				const container = document.getElementById("diary-list");

				if (container && container.dataset.supabaseEnabled === "true") {
					const labels = {
						minutesAgo: container.dataset.minutesAgo || "minutes ago",
						hoursAgo: container.dataset.hoursAgo || "hours ago",
						daysAgo: container.dataset.daysAgo || "days ago",
					};

					const load = async () => {
						if (!isDiarySupabaseConfigured()) return;

						try {
							const entries = await fetchDiaryEntries();

							// Supabase 的行结构映射成 DiaryItem，交给共享渲染器
							const moments: DiaryItem[] = entries.map((entry) => ({
								id: entry.id,
								content: entry.content,
								date: entry.created_at,
								images: entry.images,
								tags: entry.tags,
							}));

							renderDiaryList(moments, labels);
						} catch (error) {
							// 静默失败：构建时的静态数据已经在页面上了
							console.error("[diary] 从 Supabase 加载失败:", error);
						}
					};

					void load();
					document.addEventListener(
						"swup:contentReplaced",
						() => void load(),
					);
				}
			</script>
		)
	}
</MainGridLayout>
