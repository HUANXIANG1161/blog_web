---
/**
 * 相册详情页（Supabase 数据源）
 *
 * 为什么是固定路径 + 查询参数，而不是 /albums/<id>/：
 *   本站是 output: "static"，动态路由必须有 getStaticPaths() 在构建时枚举出
 *   所有路径。而 Supabase 里的相册 id 在构建时拿不到（也可能随时新增），
 *   所以 /albums/<id>/ 这种动态路由生成不出来。
 *
 *   于是改用固定路径 /albums/view/?id=N：页面本身是静态的，id 由查询参数
 *   在客户端解析后拉取数据。代价是 URL 不好看，但不需要任何服务端能力。
 *
 *   本地相册（public/images/albums）仍然走 /albums/<文件夹名>/ 的静态路由。
 */
import { Icon } from "astro-icon/components";

import { albumsSupabaseConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export const prerender = true;

if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={i18n(I18nKey.albums)} description={i18n(I18nKey.albumsSubtitle)}>
	<script>
		import("@/scripts/right-sidebar-layout.js");
		import { loadIconify } from "@/utils/icon-loader";

		loadIconify().catch((error: unknown) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<!-- 加载态 -->
	<div id="album-detail-loading" class="card-base px-6 py-16 text-center">
		<Icon
			name="material-symbols:progress-activity"
			class="text-5xl text-black/20 dark:text-white/20 animate-spin mb-3"
		/>
		<p class="text-black/50 dark:text-white/50">{i18n(I18nKey.albumsLoading)}</p>
	</div>

	<!-- 出错 / 找不到 -->
	<div id="album-detail-error" class="card-base px-6 py-16 text-center hidden">
		<Icon
			name="material-symbols:photo-library"
			class="text-6xl text-black/15 dark:text-white/15 mb-4"
		/>
		<p id="album-detail-error-text" class="text-lg text-black/50 dark:text-white/50">
			{i18n(I18nKey.albumsLoadFailed)}
		</p>
		<a
			href="/albums/"
			data-no-swup="true"
			class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mt-4"
		>
			<Icon name="material-symbols:arrow-back" class="text-base" />
			{i18n(I18nKey.albumsBackToList)}
		</a>
	</div>

	<!-- 实际内容，拉取成功后填充 -->
	<div id="album-detail" class="hidden">
		<!-- 封面横幅 -->
		<div class="w-full rounded-(--radius-large) overflow-hidden relative">
			<div id="album-cover-wrap" class="relative w-full aspect-3/1 min-h-50 max-h-90">
				<img id="album-cover" src="" alt="" class="w-full h-full object-cover" />
				<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>
				<a
					href="/albums/"
					data-no-swup="true"
					class="absolute top-4 left-4 inline-flex items-center gap-1.5 text-sm text-white/90 hover:text-white bg-black/30 hover:bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg transition-colors"
				>
					<Icon name="material-symbols:arrow-back" class="text-base" />
					{i18n(I18nKey.albumsBackToList)}
				</a>
				<div class="absolute bottom-0 left-0 right-0 p-6">
					<div
						id="album-title"
						class="text-2xl sm:text-3xl font-bold text-white mb-2 drop-shadow-lg"
					>
					</div>
					<p
						id="album-description"
						class="hidden text-sm text-white/75 leading-relaxed mb-2 max-w-2xl line-clamp-2"
					>
					</p>
					<div class="flex items-center gap-4 text-sm text-white/80 flex-wrap">
						<span class="inline-flex items-center gap-1">
							<Icon name="material-symbols:photo-library" class="text-sm" />
							<span id="album-count">0</span>
							{i18n(I18nKey.albumsPhotosCount)}
						</span>
					</div>
				</div>
			</div>
		</div>

		<!-- 照片瀑布流 -->
		<div class="w-full rounded-(--radius-large) overflow-hidden relative mt-4">
			<div class="card-base z-10 px-6 py-6 relative w-full">
				<div id="album-photos" class="gallery-masonry"></div>
				<p id="album-photos-empty" class="hidden text-lg text-center py-16 text-black/40 dark:text-white/40">
					{i18n(I18nKey.albumsEmpty)}
				</p>
			</div>
		</div>
	</div>

	<div
		id="album-runtime"
		class="hidden"
		aria-hidden="true"
		data-supabase-enabled={albumsSupabaseConfig.enable ? "true" : "false"}
		data-not-found={i18n(I18nKey.albumsEmpty)}
		data-load-failed={i18n(I18nKey.albumsLoadFailed)}
	></div>
</MainGridLayout>

{
	albumsSupabaseConfig.enable && (
		<>
			{/*
				这个脚本会被 Astro 打包，URL 稳定。它在页面首次加载时执行一次，
				把渲染函数挂到 window 上供下面的内联脚本调用。
				详情：为什么不能只靠它自己，见内联脚本里的注释。
			*/}
			<script>
				import { initAlbumDetailPage } from "@components/features/albums-supabase/detail";

				(
					window as unknown as Record<string, unknown>
				).__initAlbumDetailPage = initAlbumDetailPage;

				// 首次直接打开这个页面时，也由它启动
				initAlbumDetailPage();
			</script>

			<script is:inline>
				/**
				 * 为什么还需要这个内联脚本：
				 *
				 * 站点用 Swup 做无刷新跳转。Swup 会把新页面的 <script type="module">
				 * 标签插进 DOM，但浏览器不会重新执行 URL 相同的 ES 模块 ——
				 * 实测从相册列表点进详情页时，上面那个脚本「一次都没执行」，
				 * 于是详情页永远停在加载中。
				 *
				 * is:inline 的脚本每次插入 DOM 都会重新执行，所以由它来兜底：
				 * 调用上面挂好的函数（函数内部自己等待容器出现）。
				 * 直接打开本页时两者都会调用，靠函数内部的幂等标记去重。
				 */
				(function () {
					function boot() {
						var fn = window.__initAlbumDetailPage;
						if (typeof fn === "function") return fn();
						return false;
					}

					boot();
					if (document.readyState === "loading") {
						document.addEventListener("DOMContentLoaded", boot);
					}
					document.addEventListener("swup:page:view", boot);
					document.addEventListener("swup:visit:end", boot);
				})();
			</script>
		</>
	)
}
