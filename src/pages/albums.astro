---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { AlbumCard } from "@components/features/albums";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig, albumsSupabaseConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { scanAlbums } from "../utils/album-scanner";

if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

const albumsData = await scanAlbums();

// Collect all unique tags for filtering
const allTags = [...new Set(albumsData.flatMap((a) => a.tags || []))].sort();

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: albumsData.length,
	},
	...allTags.map((tag) => ({
		value: tag,
		label: tag,
		count: albumsData.filter((a) => a.tags?.includes(tag)).length,
	})),
];

const title = i18n(I18nKey.albums);
const subtitle = i18n(I18nKey.albumsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			{
				albumsData.length > 0 && allTags.length > 0 && (
					<div class="mb-8">
						<FilterTabs tabs={filterTabs} dataAttr="tags" />
					</div>
				)
			}

			<div id="albums-grid" class="grid gap-6 items-start">
				{albumsData.map((album) => <AlbumCard album={album} />)}
			</div>

			<div id="no-results" class="hidden text-center py-16">
				<Icon
					name="material-symbols:search-off-rounded"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg">
					{i18n(I18nKey.albumsNoResults)}
				</p>
			</div>

			<!--
				空状态。构建时没有相册时会显示，但 Supabase 数据是客户端拉取的，
				拿到数据后要把这块收起来 —— 所以这里挂个 id 供脚本控制。
			-->
			<div
				id="albums-empty"
				class:list={["text-center py-16", albumsData.length > 0 && "hidden"]}
			>
				<Icon
					name="material-symbols:photo-library"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2">
					{i18n(I18nKey.albumsEmpty)}
				</h3>
				<p class="text-black/60 dark:text-white/60">
					{i18n(I18nKey.albumsEmptyDesc)}
				</p>
			</div>

			<!-- 客户端拉取时的加载态 -->
			<div id="albums-loading" class="hidden text-center py-16">
				<Icon
					name="material-symbols:progress-activity"
					class="text-5xl text-black/20 dark:text-white/20 animate-spin mb-3"
				/>
				<p class="text-black/50 dark:text-white/50">
					{i18n(I18nKey.albumsLoading)}
				</p>
			</div>
		</div>
	</div>

	<!--
		把运行期配置传给客户端脚本
	-->
	<div
		id="albums-runtime"
		class="hidden"
		aria-hidden="true"
		data-supabase-enabled={albumsSupabaseConfig.enable ? "true" : "false"}
		data-photos-label={i18n(I18nKey.albumsPhotosCount)}
		data-load-failed={i18n(I18nKey.albumsLoadFailed)}
	></div>
</MainGridLayout>

<!--
	Supabase 数据源。
	相册在客户端拉取后再渲染 —— 这样网页上传后刷新就能看到，不需要等站点重建。
	构建时扫描 public/images/albums 得到的本地相册会先渲染出来做兜底。
-->
{
	albumsSupabaseConfig.enable && (
		<script>
			import {
				fetchAlbumsWithPhotos,
				isAlbumsSupabaseConfigured,
			} from "@components/features/albums-supabase/client";
			import {
				renderAlbums,
				showAlbumsError,
				showAlbumsLoading,
			} from "@components/features/albums-supabase/render";

			const runtime = document.getElementById("albums-runtime")?.dataset;

			if (runtime?.supabaseEnabled === "true") {
				const labels = { photosLabel: runtime.photosLabel || "" };
				const loadFailedLabel = runtime.loadFailed || "load failed";

				const load = async () => {
					if (!isAlbumsSupabaseConfigured()) return;

					showAlbumsLoading();
					try {
						const albums = await fetchAlbumsWithPhotos();
						renderAlbums({ albums, labels });
					} catch (error) {
						console.error("[albums] 从 Supabase 加载失败:", error);
						showAlbumsError(loadFailedLabel);
					}
				};

				// 立即跑一次；Swup 跳转回来时再跑一次。
				// 用 swup:page:view（站点其它脚本也用这个），它在内容替换后触发。
				void load();
				document.addEventListener("swup:page:view", () => void load());
			}
		</script>
	)
}

<style is:global>
	#albums-grid {
		grid-template-columns: 1fr;
	}

	@media (width >= 640px) {
		#albums-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	#main-grid[data-layout-mode="grid"] #albums-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	@media (width < 640px) {
		#main-grid[data-layout-mode="grid"] #albums-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
